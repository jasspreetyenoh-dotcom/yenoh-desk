# Copy these into the Vercel project settings (Settings > Environment Variables).
# Never commit real values.

# From your Turso database (see README, step 1)
TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
TURSO_AUTH_TOKEN=

# Any long random text. Vercel sends it with the daily job so strangers cannot trigger it.
CRON_SECRET=
