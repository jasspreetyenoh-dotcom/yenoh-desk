# Copy these into the Vercel project settings (Settings > Environment Variables).
# Never commit real values.

# From your Turso database (see README, step 1)
TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
TURSO_AUTH_TOKEN=

# Any long random text. Vercel sends it with the daily jobs so strangers cannot trigger them.
CRON_SECRET=

# Optional: email notifications (see README, "Notifications"). Without these, the in-app bell still works.
RESEND_API_KEY=
MAIL_FROM=Yenoh Desk <desk@mail.yenoh.in>
APP_URL=https://desk.yenoh.in
